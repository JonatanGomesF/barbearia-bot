    "express": "^4.21.2",
    "puppeteer": "^24.10.2",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "socket.io": "^4.8.1",
    "whatsapp-web.js": "^1.34.1"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.23.0",
    "javascript-obfuscator": "^5.8.0"
  }
}
