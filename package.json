{
  "name": "botsalaorev",
  "version": "1.0.0",
  "description": "Bot de agendamento para salão/barbearia via WhatsApp com Dashboard Web e Prevenção de Conflitos",
  "main": "chatbot.js",
  "bin": "chatbot.js",
  "scripts": {
    "start": "node chatbot.js",
    "dev": "node chatbot.js",
    "build:exe": "node build_exe.js"
  },
  "pkg": {
